<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>RedisNearCache.HybridCache</RootNamespace>
    <PackageId>RedisNearCache.HybridCache</PackageId>
    <Description>HybridCache and IDistributedCache adapters for RedisNearCache.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- dotnet pack compares the public API with the published baseline and fails on a breaking change, so a
         consumer of an earlier 1.x can always take a later one. Raise the baseline only to a released version. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RedisNearCache/RedisNearCache.csproj" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RedisNearCache.Tests" />
    <InternalsVisibleTo Include="RedisNearCache.UnitTests" />
  </ItemGroup>
</Project>
