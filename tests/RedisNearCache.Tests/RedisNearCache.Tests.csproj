<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RedisNearCache/RedisNearCache.csproj" />
    <ProjectReference Include="../../src/RedisNearCache.HybridCache/RedisNearCache.HybridCache.csproj" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Not centrally pinned in Directory.Packages.props (only the .Abstractions package is); the test
         project needs the concrete ServiceCollection/BuildServiceProvider, so the version is overridden
         here to match the pinned Microsoft.Extensions.*.Abstractions version (10.0.12) rather than
         touching the shared props file. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Needed only for the host-level ValidateOnStart test (Host.CreateApplicationBuilder / IHost.StartAsync);
         already centrally pinned in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The real Microsoft Entra ID extension, driven by Auth/EntraIdTests.cs against a local container with a
         fake TokenCredential. Integration tests only: nothing under src/ references it. -->
    <PackageReference Include="Microsoft.Azure.StackExchangeRedis" />
  </ItemGroup>
</Project>
